manifest {
    name = 'sersancar/Clinically-prioritised-antibiotic-resistance'
    description = 'Coastal One Health AMR surveillance: ENA to manuscript outputs'
    mainScript = 'main.nf'
    nextflowVersion = '>=25.04.8'
    version = '0.1.0-dev'
}
params {
    mode = 'full'
    filters = "${projectDir}/metadata/filters.tsv"
    study = 'PRJEB75359'
    ena_report = null
    carpdm_fasta = null
    crass_fasta = null
    reference_lock = null
    kraken_db = null
    amr_adapter = null
    taxonomy_adapter = "${projectDir}/adapters/taxonomy_original.sh"
    report_adapter = null
    outdir = 'results'
    bowtie2_preset = 'very-sensitive'
    analysis_inputs = null
    broad_taxonomy = null
    domain_map = null
    carpdm_unfiltered = false
    amr_bam_manifest = null
    amr_count_policy = null
}
process {
    cpus = 4
    memory = '16 GB'
    time = '24h'
    shell = ['/bin/bash', '-euo', 'pipefail']
    errorStrategy = 'terminate'
    withName: 'DOWNLOAD' { cpus = 1; memory = '1 GB'; maxForks = 4; errorStrategy = 'retry'; maxRetries = 2 }
    withName: 'MERGE_READS' { cpus = 1; memory = '1 GB' }
    withName: 'KRAKEN' { memory = '64 GB' }
}
profiles {
    conda { conda.enabled = true }
    slurm { process.executor = 'slurm'; executor.queueSize = 30 }
    test {
        params.filters = "${projectDir}/metadata/filters.tsv"
        process {
            cpus = 1
            memory = '512 MB'
            withName: 'KRAKEN' { memory = '512 MB' }
        }
    }
}
def runProvenanceStamp = new Date().format('yyyyMMdd_HHmmss_SSS')
timeline { enabled = true; file = "${params.outdir}/provenance/timeline_${runProvenanceStamp}.html" }
report { enabled = true; file = "${params.outdir}/provenance/execution_${runProvenanceStamp}.html" }
trace { enabled = true; file = "${params.outdir}/provenance/trace_${runProvenanceStamp}.tsv" }
dag { enabled = true; file = "${params.outdir}/provenance/dag_${runProvenanceStamp}.html" }

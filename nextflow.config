manifest {
 name='sersancar/Clinically-prioritised-antibiotic-resistance'
 description='ENA to coastal One Health AMR measurements, statistics, tables and figures'
 mainScript='main.nf'
 nextflowVersion='>=25.04.8'
 version='0.2.0'
}
params {
 mode='full'
 filters="${projectDir}/data/filters.tsv"
 study='PRJEB75359'
 carpdm_fasta="${projectDir}/data/carpdm_genes.fna.gz"
 kraken_db=null
 taxonomy_dir=null
 megares_fasta=null
 crass_fasta=null
 snp_bundle=null
 outdir='results'
 seed=20261112
 permutations=9999
 kraken_memory='128 GB'
}
process {
 cpus=4
 memory='16 GB'
 time='48h'
 shell=['/bin/bash','-euo','pipefail']
 errorStrategy='terminate'
 withLabel: small { cpus=1; memory='2 GB' }
 withLabel: taxonomy { memory={ params.kraken_memory } }
 withName: VERIFY_SNPS { cpus=1 }
}
profiles {
 conda { conda.enabled=true }
 slurm {
  process.executor='slurm'
  executor.queueSize=30
  process {
   withName: 'RESOLVE_ENA|DOWNLOAD|PREPARE_RESOURCES' { executor='local' }
  }
 }
 test {
  process {
   cpus=1; memory='512 MB'
   withLabel: small { cpus=1; memory='512 MB' }
   withLabel: taxonomy { cpus=1; memory='512 MB' }
  }
 }
}
def stamp=new Date().format('yyyyMMdd_HHmmss_SSS')
timeline { enabled=true; file="${params.outdir}/provenance/timeline_${stamp}.html" }
report { enabled=true; file="${params.outdir}/provenance/execution_${stamp}.html" }
trace { enabled=true; file="${params.outdir}/provenance/trace_${stamp}.tsv" }
dag { enabled=true; file="${params.outdir}/provenance/dag_${stamp}.html" }

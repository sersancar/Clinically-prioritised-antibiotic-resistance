manifest {
 name='sersancar/Clinically-prioritised-antibiotic-resistance'
 description='ENA to coastal One Health AMR measurements, statistics, tables and figures'
 mainScript='main.nf'
 nextflowVersion='>=25.04.8'
 version='0.2.0'
}
params {
 mode='full'
 filters="${projectDir}/data/filters.tsv"
 study='PRJEB75359'
 carpdm_fasta="${projectDir}/data/carpdm_genes.fna.gz"
 kraken_db=null
 kraken_url='https://genome-idx.s3.amazonaws.com/kraken/k2_standard_20251015.tar.gz'
 kraken_checksums_url='https://genome-idx.s3.amazonaws.com/kraken/standard_20251015/standard.md5'
 kraken_manifest_sha256='e03fb50c285197a8ee7a04e2b0a2c28b34470d319fd546b146149a1a2362df53'
 taxonomy_dir=null
 megares_fasta=null
 crass_fasta=null
 snp_bundle=null
 outdir='results'
 seed=20261112
 permutations=9999
 // Nextflow scheduling request; not a hard RAM cap under the local executor.
 kraken_memory='48 GB'
 // Use disk-backed access instead of preloading the entire database.
 kraken_memory_mapping=true
}
process {
 cpus=4
 memory='16 GB'
 time='48h'
 shell=['/bin/bash','-euo','pipefail']
 errorStrategy='terminate'
 withLabel: small { cpus=1; memory='2 GB' }
 withLabel: taxonomy { memory={ params.kraken_memory } }
 withName: VERIFY_SNPS { cpus=1 }
}
profiles {
 conda { conda.enabled=true }
 slurm {
  process.executor='slurm'
  executor.queueSize=30
  process {
   withName: 'RESOLVE_ENA|DOWNLOAD|PREPARE_RESOURCES|PREPARE_KRAKEN' { executor='local' }
  }
 }
 test {
  process {
   cpus=1; memory='512 MB'
   withLabel: small { cpus=1; memory='512 MB' }
   withLabel: taxonomy { cpus=1; memory='512 MB' }
  }
 }
}
params.run_stamp=new java.util.Date().format('yyyyMMdd_HHmmss_SSS')
timeline { enabled=true; file="${params.outdir}/provenance/timeline_${params.run_stamp}.html" }
report { enabled=true; file="${params.outdir}/provenance/execution_${params.run_stamp}.html" }
trace { enabled=true; file="${params.outdir}/provenance/trace_${params.run_stamp}.tsv" }
dag { enabled=true; file="${params.outdir}/provenance/dag_${params.run_stamp}.html" }
